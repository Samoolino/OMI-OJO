    "analysis_result_refs": "required",
    "quantity": "required_when_measured",
    "unit": "required_when_quantity_recorded",
    "production_timestamp": "required",
    "operator_id": "required",
    "status": "required",
    "integrity_digest": "required"
  },
  "seal_record": {
    "seal_id": "required",
    "batch_id": "required",
    "seal_type": "required",
    "application_timestamp": "required",
    "operator_id": "required",
    "tamper_evidence_status": "required",
