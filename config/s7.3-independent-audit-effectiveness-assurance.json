  "controls": [
    "auditor independence must be declared",
    "audit criteria and scope are frozen before examination",
    "sample selection is recorded",
    "findings cite evidence and criteria",
    "limitations are explicit",
    "CAPA effectiveness is assessed against predefined criteria",
    "material findings trigger HOLD/escalation",
    "historical evidence is never rewritten"
  ],
  "fail_closed_conditions": [
    "independence not established",
    "scope/criteria missing",
    "sample selection undocumented",
    "material finding lacks evidence",
    "affected scope unclear",
    "CAPA effectiveness claimed without evidence",
    "material finding closed without authorized disposition",
    "limitations concealed",
    "integrity evidence missing"
  ],
  "permissible_claims": [
    "an independent audit was performed for the defined scope",
    "specified findings were identified",
    "CAPA effectiveness was assessed against recorded criteria",
    "assurance status is traceable"
  ],
  "prohibited_claims": [
    "audit proves universal compliance",
    "limited sampling proves absence of all issues",
    "assurance substitutes for regulatory authorization",
    "audit confirmation proves water safety",
    "historical evidence can be altered"
  ],
  "next_gate": "S7.4_GOVERNANCE_AND_PERIODIC_ASSURANCE_REVIEW"
